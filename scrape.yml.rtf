\f0\fs24 \cf0 name: Weekly School Data Scraper\
\
on:\
  schedule:\
    - cron: '0 8 * * 1' # Runs automatically every Monday\
  workflow_dispatch:      # Allows manual trigger button\
\
jobs:\
  scrape-and-update:\
    runs-on: ubuntu-latest\
    steps:\
      - uses: actions/checkout@v4\
      - uses: actions/setup-python@v5\
        with:\
          python-version: '3.11'\
      - run: pip install pandas requests beautifulsoup4\
      - run: python scraper.py\
      - run: |\
          git config --global user.name 'github-actions[bot]'\
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'\
          git add hongkong_schools.csv\
          git diff --quiet && git diff --staged --quiet || (git commit -m "Auto-update photos and data" && git push)}